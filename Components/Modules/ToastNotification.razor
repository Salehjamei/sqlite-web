@namespace sqlite_web.Components.Modules

@if (Items != null && Items.Any())
{
    bool isRtl = CurrentLanguage == "fa" || CurrentLanguage == "ar";

    <div class="glass-toast-stack @(isRtl ? "glass-toast-rtl" : "glass-toast-ltr")"
         style="direction: @(isRtl ? "rtl" : "ltr"); text-align: @(isRtl ? "right" : "left");">
        @foreach (var item in Items)
        {
            <div @key="item.Id"
                 class="glass-toast-card @(item.IsError ? "glass-toast-error-border" : "glass-toast-success-border") modal-animation-fade"
                 role="alert">

                @* هدر فشرده کارت اعلان: عنوان اطلاع‌رسانی + زمان سپری‌شده + دکمه بستن *@
                <div class="glass-toast-header">
                    <div class="d-flex align-items-center gap-1">
                        <span class="glass-toast-title">@CalendarManager.Translate("PCal_MainHome_Notification")</span>
                        <span class="glass-toast-time">@GetRelativeTimeText(item.ShownAt)</span>
                    </div>
                    <button type="button"
                            class="glass-toast-close"
                            @onclick="() => RemoveToastItemAsync(item.Id)"
                            aria-label="Close">
                        ✕
                    </button>
                </div>

                @* متن فشرده و خوانای پیام *@
                <div class="glass-toast-body">
                    <span>@((MarkupString)GetItemHtmlMessage(item))</span>
                </div>
            </div>
        }
    </div>
}
