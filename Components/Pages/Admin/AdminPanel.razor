                                                </div>
                                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                                    <input class="form-check-input m-0" type="checkbox" id="offMon" checked="@selectedOffDays.Contains("Monday")" @onchange='(e) => ToggleOffDaySelection("Monday", e.Value)' />
                                                    <label class="form-check-label small" for="offMon">@CalendarManager.Translate("Monday") (Mon)</label>
                                                </div>
                                                <div class="form-check d-flex align-items-center gap-2 mb-0">
                                                    <input class="form-check-input m-0" type="checkbox" id="offTue" checked="@selectedOffDays.Contains("Tuesday")" @onchange='(e) => ToggleOffDaySelection("Tuesday", e.Value)' />
                                                    <label class="form-check-label small" for="offTue">@CalendarManager.Translate("Tuesday") (Tue)</label>
                                                </div>
                                            </div>

                                            <div class="col-6">
                                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                                    <input class="form-check-input m-0" type="checkbox" id="offWed" checked="@selectedOffDays.Contains("Wednesday")" @onchange='(e) => ToggleOffDaySelection("Wednesday", e.Value)' />
                                                    <label class="form-check-label small" for="offWed">@CalendarManager.Translate("Wednesday") (Wed)</label>
                                                </div>
                                                <div class="form-check d-flex align-items-center gap-2 mb-1">
                                                    <input class="form-check-input m-0" type="checkbox" id="offThu" checked="@selectedOffDays.Contains("Thursday")" @onchange='(e) => ToggleOffDaySelection("Thursday", e.Value)' />
                                                    <label class="form-check-label small" for="offThu">@CalendarManager.Translate("Thursday") (Thu)</label>
                                                </div>
                                                <div class="form-check d-flex align-items-center gap-2 mb-0">
                                                    <input class="form-check-input m-0" type="checkbox" id="offFri" checked="@selectedOffDays.Contains("Friday")" @onchange='(e) => ToggleOffDaySelection("Friday", e.Value)' />
                                                    <label class="form-check-label small" for="offFri">@CalendarManager.Translate("Friday") (Fri)</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 mt-2 border-top pt-3">
                                        <button type="submit" class="btn btn-dark text-warning btn-sm flex-grow-1 fw-bold" style="font-size: 12px; height: 32px;">
                                            @CalendarManager.Translate("SaveBtn")
                                        </button>
                                        <button type="button" @onclick="() => showSettingsModal = false" class="btn btn-secondary btn-sm" style="font-size: 12px; height: 32px;">
                                            @CalendarManager.Translate("CancelBtn")
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                }

            }
        </div>

        <DeleteModal Show="@showDeleteModal"
                     Title="@deleteModalTitle"
                     TargetName="@targetDeleteName"
                     SelectedItemLabel='@(CalendarManager.Translate("DeleteSelectedItem"))'
                     DeleteConfirmBtn='@(CalendarManager.Translate("DeleteConfirmBtn"))'
                     kancelBtn='@(CalendarManager.Translate("kancelBtn"))'
                     Message="@deleteTargetMessage"
                     SubMessage="@deleteModalSubMessage"
                     OnConfirm="ExecuteConfirmedDelete"
                     OnCancel="CancelDeleteModal" />
