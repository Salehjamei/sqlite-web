@page "/admin/manage-admins"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using sqlite_web
@using sqlite_web.Components.Models.Admin

@if (!AdminState.IsAuthorized && AdminState.IsChecked)
{
    <div class="alert alert-danger text-center shadow-sm fw-bold mt-5">
        ❌ این صفحه اختصاصی بوده و فقط مدیریت ارشد به آن دسترسی دارد!
    </div>
}
else
{
    <!-- [بقیه کدهای جدول فرم ثبت ادمین جدید] -->
    <div class="row">
        <!-- فرم ثبت و اعطای دسترسی تفکیکی -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white fw-bold">
                    @(isEditMode ? "✏️ ویرایش مشخصات و دسترسی‌ها" : "👤 ثبت مدیر جدید")
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label text-muted small">نام و نام خانوادگی:</label>
                        <input type="text" @bind="adminFullName" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small">نام کاربری:</label>
                        <input type="text" @bind="adminUsername" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">رمز عبور:</label>
                        <input type="password" @bind="adminPassword" class="form-control form-control-sm" />
                    </div>

                    <!-- 🛠️ بخش چک‌باکس‌های اهدا دسترسی تفکیکی -->
                    <div class="p-3 bg-light rounded border mb-3">
                        <!-- 👑 اضافه شدن چک‌باکس جدید دسترسی سوپر ادمین در فرم ثبت/ویرایش صفحه ManageAdmins.razor -->
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="isSuperAdminCheck" @bind="pIsSuperAdmin" />
                            <label class="form-check-label fw-bold text-danger" for="isSuperAdminCheck">👑 اعطای دسترسی سوپر ادمین (مدیریت مدیران سیستم)</label>
                        </div>

                        <h6 class="fw-bold small text-secondary mb-2">🛡️ تعیین سطوح دسترسی پرسنلی:</h6>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" @bind="pCanAdd" id="chkAdd">
                            <label class="form-check-input-label small ms-2" for="chkAdd">توانایی <b>افزودن</b> پرسنل جدید</label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" @bind="pCanEdit" id="chkEdit">
                            <label class="form-check-input-label small ms-2" for="chkEdit">توانایی <b>ویرایش ساعت و حاضر کردن</b> پرسنل</label>
                        </div>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" @bind="pCanDelete" id="chkDelete">
                            <label class="form-check-input-label small ms-2" for="chkDelete">توانایی <b>حذف</b> پرسنل و رکوردها</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" @onclick="SaveAdmin" class="btn btn-danger btn-sm flex-grow-1">ذخیره مدیر</button>
                        @if (isEditMode)
                        {
                            <button type="button" @onclick="CancelEdit" class="btn btn-secondary btn-sm">انصراف</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- جدول نمایش لیست و وضعیت دسترسی‌ها -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white fw-bold">📋 لیست کل مدیران و مجوزهای فعال</div>
                <div class="card-body p-0">
                    <table class="table table-bordered table-striped text-center align-middle m-0 table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>نام مدیر</th>
                                <th>نام کاربری</th>
                                <th>مجوزها (افزودن | ویرایش | حذف)</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (adminList != null)
                            {
                                @foreach (var ad in adminList)
                                {
                                    <tr>
                                        <td><strong>@ad.FullName</strong></td>
                                        <td><span class="badge bg-light text-dark">@ad.Username</span></td>
                                        <td>
                                            @if (ad.IsSuperAdmin)
                                            {
                                                <span class="badge bg-danger">👑 دسترسی کامل (ارشد کل)</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex gap-1 justify-content-center">
                                                    <span class="badge @(ad.CanAddEmployee ? "bg-success" : "bg-outline-secondary text-muted")">افزودن</span>
                                                    <span class="badge @(ad.CanEditEmployee ? "bg-primary" : "bg-outline-secondary text-muted")">ویرایش</span>
                                                    <span class="badge @(ad.CanDeleteEmployee ? "bg-danger" : "bg-outline-secondary text-muted")">حذف</span>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (!ad.IsSuperAdmin)
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-xs fw-bold me-1" @onclick="() => StartEdit(ad)">✏️ دسترسی‌ها</button>
                                                <button type="button" class="btn btn-outline-danger btn-xs fw-bold" @onclick="() => DeleteAdmin(ad.Id)">🗑️ حذف</button>
                                            }
                                            else
                                            {
                                                <small class="text-muted">غیرقابل تغییر</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert alert-info text-center mt-3 p-2 small">@feedbackMessage</div>
    }
}
