@page "/login"
@rendermode InteractiveServer
@using sqlite_web.Services
@inject AdminStateService AdminState

<div class="login-container" style="max-width: 400px; margin: 100px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
    <h3 style="text-align: center; margin-bottom: 20px;">ورود به پنل مدیریت</h3>

    <EditForm Model="this" OnValidSubmit="HandleLogin" FormName="admin-login-form">
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">نام کاربری:</label>
            <input type="text" class="form-control" style="width: 100%; padding: 8px; box-sizing: border-box;" @bind="Username" autocomplete="username" />
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px;">رمز عبور:</label>
            <input type="password" class="form-control" style="width: 100%; padding: 8px; box-sizing: border-box;" @bind="Password" autocomplete="current-password" />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
            ورود به سیستم
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(AdminState.FeedbackMessage))
    {
        <div style="margin-top: 15px; padding: 10px; border-radius: 4px; text-align: center;
            background-color: @(AdminState.FeedbackMessage.Contains("✅") ? "#d4edda" : "#f8d7da");
            color: @(AdminState.FeedbackMessage.Contains("✅") ? "#155724" : "#721c24");">
            @AdminState.FeedbackMessage
        </div>
    }
</div>
