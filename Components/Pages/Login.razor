@page "/login"
@rendermode InteractiveServer

<div class="container mt-5" dir="rtl" style="text-align: right; font-family: Tahoma;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h5 class="m-0 fw-bold">🔒 ورود به پنل مدیریت سیستم</h5>
                </div>
                <div class="card-body p-4">
                    <form @onsubmit="ExecuteServiceLogin" @onsubmit:preventDefault>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">نام کاربری ادمین:</label>
                            <input type="text" class="form-control" @bind="localUsername" placeholder="نام کاربری را وارد کنید..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">رمز عبور ادمین:</label>
                            <input type="password" class="form-control" @bind="localPassword" placeholder="رمز عبور را وارد کنید..." />
                        </div>

                        @if (!string.IsNullOrEmpty(feedbackMessage))
                        {
                            <div class="alert alert-danger text-center small fw-bold py-2">@feedbackMessage</div>
                        }

                        <button type="submit" class="btn btn-dark w-100 fw-bold mt-2 py-2">🔑 ورود به حساب کاربری</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
