@inherits LayoutComponentBase
@namespace sqlite_web.Components.Layout

<div class="page">
    @* --- 📱 هدر امن و ریسپانسیو سیستم حضور و غیاب پرسنل --- *@
    <header class="navbar-system">

        @* 🔹 بخش همبرگری و نام ادمین در لبه‌ها (فقط زمانی رندر می‌شوند که منوی موبایل بسته باشد) *@
        <div class="navbar-main">
            @if (!IsMobileMenuOpen)
            {
                @* دکمه منوی همبرگری موبایل *@
                <button type="button" class="menu-toggle-btn" @onclick="ToggleMobileMenu">
                    ☰
                </button>

                @* نمایش مینی‌مال نام ادمین روبه‌روی همبرگری در لبه مقابل موبایل *@
                @if (AdminState.IsAuthorized)
                {
                    <span class="user-welcome-text mobile-only">👤 @AdminState.adminUsername</span>
                }
            }
        </div>

        @* 🔒 کانتینر منوی هوشمند (به محض باز شدن، ساختار مستقل و چیدمان ردیفی مرکزی می‌گیرد) *@
        <div class="header-actions-container @(IsMobileMenuOpen ? "open" : "")">
            @if (AdminState.IsAuthorized)
            {
                @* 🔒 گارد دسترسی دکمه‌ها در ادمین پنل *@
                @if (IsCurrentlyInAdminPanel)
                {
                    <div class="nav-management-group nav-grid-mobile">
                        @* 🏠 دکمه بازگشت به کیوسک تردد *@
                        <button type="button" class="btn-modern btn-modern-secondary @(ActivePage == "home" ? "active-custom" : "")" @onclick='() => NavigateToPage("/")'>
                            🏠 کیوسک تردد
                        </button>

                        @* 👥 دکمه مدیریت پرسنل *@
                        <button type="button" class="btn-modern btn-modern-primary @(ActivePage == "panel" ? "active-custom" : "")" @onclick='() => NavigateToPage("/admin/panel")'>
                            👥 مدیریت پرسنل
                        </button>

                        @* 👑 دکمه سطوح دسترسی مخصوص سوپر ادمین *@
                        @if (AdminState.isCurrentUserSuperAdmin)
                        {
                            <button type="button" class="btn-modern btn-modern-warning @(ActivePage == "manage" ? "active-custom" : "")" @onclick='() => NavigateToPage("/admin/manage-admins")'>
                                👑 سطوح دسترسی
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="nav-management-group">
                        <button type="button" class="btn-modern btn-modern-primary" @onclick="NavigateToDashboardSafe">
                            💼 داشبورد مدیریت
                        </button>
                    </div>
                }

                @* 🟢 زون تفکیک شده خروج و نام ادمین در دسکتاپ و ردیف اول افقی موبایل *@
                <div class="logout-left-zone">
                    <span class="user-welcome-text desktop-only">👤 @AdminState.adminUsername</span>
                    <button type="button" class="btn-modern btn-modern-danger" @onclick="OpenLogoutModal">
                        🏃‍♂️ خروج از پنل
                    </button>
                </div>

                @* 🎯 X کاراکتر استاندارد کیبورد بدون پس‌زمینه - کاملاً خارج از لیست دکمه‌ها و شناور زیر مرکز هدر *@
                <button type="button" class="btn-close-keyboard-x mobile-only" @onclick="CloseMobileMenu" title="بستن منو">
                    X
                </button>
            }
            else
            {
                <button type="button" class="btn-modern btn-modern-success" @onclick='() => NavigateToPage("/login")'>
                    🔑 ورود به پنل مدیریت
                </button>
            }
        </div>
    </header>

    @* لمس بدنه اصلی صفحات به صورت هوشمند منو را ناپدید می‌کند *@
    <main class="content px-4" @onclick="CloseMobileMenu">
        @Body
    </main>
</div>

@* --- 🔒 مودال تعاملی تاییدیه خروج ادمین فیکس شده در مرکز کل مانیتور --- *@
@if (ShowLogoutConfirmModal)
{
    <div style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100% !important; height: 100vh !important; background-color: rgba(0, 0, 0, 0.6) !important; z-index: 9999999 !important; display: flex !important; justify-content: center !important; align-items: center !important; padding: 15px !important;">
        <div class="modal-animation-fade" style="background: #ffffff !important; border-radius: 8px !important; width: 100% !important; max-width: 440px !important; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important; display: flex !important; flex-direction: column !important; overflow: hidden !important;">
            <div class="bg-dark text-white p-3 fw-bold" style="text-align: right; direction: rtl; font-size: 15px;">🚪 تاییدیه خروج از سیستم</div>
            <div class="p-3 text-right" style="direction: rtl; background: #ffffff;">
                <p class="fw-bold text-dark" style="font-size: 14px; margin-bottom: 8px;">آیا برای خروج از پنل مدیریت سیستم مطمئن هستید؟</p>
                <p class="text-muted small m-0" style="line-height: 1.6;">با خروج شما، سشن فعلی باطل شده و نیاز به ورود مجدد خواهید داشت.</p>
            </div>
            <div class="p-3 bg-light d-flex justify-content-end gap-2 border-top" style="direction: ltr;">
                <button type="button" class="btn btn-danger btn-sm px-3 fw-bold" @onclick="ExecuteConfirmedLogout">بله، خارج می‌شوم</button>
                <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="CloseLogoutModal">انصراف</button>
            </div>
        </div>
    </div>
}


@* --- 🔒 مودال تعاملی عدم دسترسی ادمین به دکمه داشبورد مدیریت --- *@
@if (ShowAccessDeniedModal)
{
    <div style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100% !important; height: 100vh !important; background-color: rgba(0, 0, 0, 0.6) !important; z-index: 9999999 !important; display: flex !important; justify-content: center !important; align-items: center !important; padding: 15px !important;">
        <div class="modal-animation-fade" style="background: #ffffff !important; border-radius: 8px !important; width: 100% !important; max-width: 460px !important; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important; display: flex !important; flex-direction: column !important; overflow: hidden !important;">

            <div class="bg-danger text-white p-3 fw-bold" style="text-align: right; direction: rtl;">⚠️ خطای دسترسی سیستم</div>

            <div class="p-3 text-right" style="direction: rtl; background: #ffffff;">
                <p class="fw-bold text-danger" style="font-size: 14px;">حساب کاربری شما فاقد مجوز ورود است!</p>
                <p class="text-muted small m-0" style="line-height: 1.6;">شما اجازه ورود به پنل مدیریت پرسنل را ندارید. جهت اعطای دسترسی‌های لازم، لطفاً با مدیر ارشد سیستم تماس حاصل فرمایید.</p>
            </div>

            <div class="p-3 bg-light d-flex justify-content-end border-top">
                <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="CloseAccessModal">متوجه شدم</button>
            </div>

        </div>
    </div>
}

@* --- 🔒 مودال هشدار تغییر دستی آدرس مرورگر (URL Hijacking) --- *@
@if (ShowUrlHijackModal)
{
    <div style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; width: 100% !important; height: 100vh !important; background-color: rgba(0, 0, 0, 0.6) !important; z-index: 9999999 !important; display: flex !important; justify-content: center !important; align-items: center !important; padding: 15px !important;">
        <div class="modal-animation-fade" style="background: #ffffff !important; border-radius: 8px !important; width: 100% !important; max-width: 460px !important; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important; display: flex !important; flex-direction: column !important; overflow: hidden !important;">

            <div class="bg-warning text-dark p-3 fw-bold" style="text-align: right; direction: rtl;">⚠️ هشدار عدم سطح دسترسی</div>

            <div class="p-3 text-right" style="direction: rtl; background: #ffffff;">
                <p class="fw-bold text-warning" style="color: #856404 !important; font-size: 14px;">دسترسی غیرمجاز از طریق تغییر لینک!</p>
                <p class="text-muted small m-0" style="line-height: 1.6;">کاربر محترم، حساب شما مجوز ورود مستقیم به صفحه درخواستی را ندارد. سیستم به صورت خودکار شما را به مسیر مجاز بازگرداند.</p>
            </div>

            <div class="p-3 bg-light d-flex justify-content-end border-top">
                <button type="button" class="btn btn-warning btn-sm px-4 fw-bold text-dark" @onclick="CloseUrlHijackModal">
                    متوجه شدم
                </button>
            </div>

        </div>
    </div>
}
