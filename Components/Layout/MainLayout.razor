@inherits LayoutComponentBase
@implements IDisposable

<div class="page" dir="rtl" style="font-family: Tahoma; text-align: right;">

    <!-- 🟢 هدر یکپارچه و متصل به سرویس وضعیت سراسری -->
    <header class="bg-dark text-white p-3 shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <h4 class="m-0 fw-bold">⏱️ سیستم هوشمند حضور و غیاب پرسنل</h4>
            <div class="d-flex align-items-center gap-2">

                <!-- ۱. اگر ادمین لاگین کرده بود، نام کاربری و دکمه قرمز خروج نمایش داده شود -->
                @if (!string.IsNullOrEmpty(AdminState.adminUsername) && AdminState.IsChecked)
                {
                    <span class="text-info small fw-bold me-2">👤 ادمین آنلاین: @AdminState.adminUsername</span>
                    <button type="button" @onclick="HandleGlobalLogout" class="btn btn-danger btn-sm fw-bold me-3">🏃‍♂️ خروج از حساب</button>

                    <!-- دکمه بازگشت به کیوسک فقط برای ادمین‌های مجاز در صفحات ادمین رندر شود -->
                    @if (AdminState.IsAuthorized && MyNavigationManager.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="/" class="btn btn-outline-light btn-sm fw-bold">🖥️ صفحه کیوسک پرسنل</a>
                    }
                }

                <!-- 🔒 دکمه ورود به پنل فقط زمانی نمایش داده شود که هیچ ادمینی لاگین نکرده باشد -->
                @if (string.IsNullOrEmpty(AdminState.adminUsername) && AdminState.IsChecked)
                {
                    @if (!MyNavigationManager.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="/admin" class="btn btn-outline-info btn-sm fw-bold">🔑 ورود به پنل مدیریت</a>
                    }
                }
            </div>
        </div>
    </header>

    <!-- بادی اصلی صفحات -->
    <main class="container flex-grow-1" style="min-height: 80vh;">
        @Body
    </main>

    <!-- فوتر سراسری سیستم -->
    <footer class="bg-light text-center text-muted py-3 border-top mt-5">
        <div class="container">
            <small>© @DateTime.Now.Year | طراحی و توسعه اختصاصی سیستم اتوماسیون حضور و غیاب پرسنلی</small>
        </div>
    </footer>
</div>
