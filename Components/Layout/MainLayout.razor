@inherits LayoutComponentBase

<div class="page" dir="rtl" style="font-family: Tahoma; text-align: right;">

    <!-- 🟢 هدر یکپارچه، هوشمند و سراسری سیستم حضور و غیاب پرسنل -->
    <header class="bg-dark text-white p-3 shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <h4 class="m-0 fw-bold">⏱️ سیستم هوشمند حضور و غیاب پرسنل</h4>
            <div class="d-flex align-items-center gap-2">

                <!-- 🛡️ اگر توکن سشن آنلاین در بلایزر تایید شده باشد -->
                @if (hasToken)
                {
                    <!-- نمایش مستقیم نام کاربری واقعی ادمین لاگین شده بدون فیلد تداخل‌زا -->
                    <span class="text-info small fw-bold me-2">👤 ادمین آنلاین: @adminUsername</span>

                    <!-- دکمه خروج بومی بلایزر که متد شستشوی مستقیم را صدا می‌زند -->
                    <button type="button" @onclick="ExecuteGlobalLogout" class="btn btn-danger btn-sm fw-bold me-3">🏃‍♂️ خروج از حساب</button>

                    <!-- دکمه ناوبری به کیوسک پرسنل: برای ادمین ارشد (IsAuthorized) نمایش داده شود -->
                    @if (IsAuthorized)
                    {
                        @if (MyNavigationManager.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="/" class="btn btn-outline-light btn-sm fw-bold">🖥️ صفحه کیوسک پرسنل</a>
                        }
                    }
                }
                else
                {
                    <!-- 🔒 اگر هیچ ادمینی لاگین نکرده باشد، دکمه ورود رندر شود -->
                    @if (!MyNavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="/login" class="btn btn-outline-info btn-sm fw-bold">🔑 ورود به پنل مدیریت</a>
                    }
                }

            </div>
        </div>
    </header>

    <!-- بادی اصلی صفحات سیستم -->
    <main class="container flex-grow-1" style="min-height: 80vh;">
        @Body
    </main>

    <!-- فوتر سراسری سیستم -->
    <footer class="bg-light text-center text-muted py-3 border-top mt-5">
        <div class="container">
            <small>© @DateTime.Now.Year | طراحی و توسعه اختصاصی سیستم اتوماسیون حضور و غیاب پرسنلی</small>
        </div>
    </footer>
</div>
